{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              {
                "type": true,
                "source": [":NODE:"]
              },
              {
                "type": true,
                "source": [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:"]
              },
              {
                "type": true,
                "source": [":ALIAS:"]
              },
              {
                "type": true,
                "source": [":PATH:"]
              },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": [":NODE:"]
              },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:"]
              },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": [":ALIAS:"]
              },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": [":PATH:"]
              }
            ]
          }
        }
      }
    }
  }
}
