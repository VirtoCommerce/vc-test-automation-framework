{
  "$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
  "overrides": [
    {
      "includes": ["api/graphql/generated/**", "api/rest/generated/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["api/rest/generated/**"],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": ["fixtures/**", "tests/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    },
    {
      "includes": [
        "dataset/manifest.ts",
        "tests/unit/core/interpolate.test.ts",
        "tests/unit/dataset/dataset.test.ts",
        "tests/unit/dataset/seed/seed-requests.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
