@@ -0,0 +1,22 @@
+import * as allure from "allure-js-commons";
+
+import { expect, test } from "@fixtures";
+
+test.beforeEach(async () => {
+  await allure.epic("E2E");
+  await allure.feature("Frontend / Sign-in");
+});
+
+test.describe("sign-in form (anonymous)", () => {
+  test("the sign-in page offers the form fields and the button", async ({ frontend }) => {
+    await allure.story("Form");
+    await allure.description("The sign-in page shows the email field and the sign-in button.");
+    const signIn = frontend.signIn();
+    await test.step("arrange: open the sign-in page", () => signIn.navigate());
+
+    await test.step("assert: the email field and the sign-in button are visible", async () => {
+      await expect(signIn.emailInput).toBeVisible();
+      await expect(signIn.signInButton).toBeVisible();
+    });
+  });
+});
