{
  "id": "reviewer-planted-defects",
  "role": "reviewer",
  "trap": true,
  "prompt": "Review the diff of the last commit (git show HEAD). This is a branch review: there is no contract, and the author left no run record, so report the definition of done as not done.",
  "startRef": "HEAD",
  "codeChecks": ["planted-defects", "verdict"],
  "plantedDefects": [
    "eval-store-create.spec.ts:24|toBeGreaterThanOrEqual|cannot fail|can never fail|always true",
    "eval-store-create.spec.ts:20|eval-store-create.spec.ts:19|registered after|cleanup after|after the create",
    "eval-sign-in-button.spec.ts:18|raw selector|page.locator"
  ],
  "judgeCriteria": [],
  "patch": "start.patch"
}
