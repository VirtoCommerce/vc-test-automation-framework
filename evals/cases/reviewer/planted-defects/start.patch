+import * as allure from "allure-js-commons";
+
+import { expect, test } from "@fixtures";
+
+test.beforeEach(async () => {
+  await allure.epic("E2E");
+  await allure.feature("Frontend / Sign-in");
+});
+
+test.describe("sign-in button (anonymous)", () => {
+  test("the sign-in button is visible", async ({ frontend, page }) => {
+    await allure.story("Form");
+    await allure.description("The sign-in page shows the sign-in button.");
+    const signIn = frontend.signIn();
+    await test.step("arrange: open the sign-in page", () => signIn.navigate());
+
+    await test.step("assert: the button is visible", async () => {
+      await expect(page.locator("form button.btn-primary")).toBeVisible();
+    });
+  });
+});
