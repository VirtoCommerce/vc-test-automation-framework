{
  "name": "@virtocommerce/test-automation-framework",
  "version": "0.1.0",
  "description": "Playwright Test framework for the API and browser test suites of Virto Commerce-based solutions",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VirtoCommerce/vc-test-automation-framework.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./dataset": {
      "types": "./dist/dataset/index.d.ts",
      "default": "./dist/dataset/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "default": "./dist/fixtures/index.js"
    },
    "./graphql": {
      "types": "./dist/graphql/index.d.ts",
      "default": "./dist/graphql/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "default": "./dist/modules/index.js"
    },
    "./biome": "./.biome/preset.json",
    "./biome/*": "./.biome/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    ".biome/preset.json",
    ".biome/formatter.json",
    ".biome/rules.json",
    ".biome/imports.json",
    ".claude/agents",
    ".claude/commands",
    "!.claude/commands/code-review-full.md",
    ".claude/skills",
    ".claude/checks",
    "!.claude/checks/ours-only.json",
    ".claude/hooks",
    ".claude/settings.json",
    ".qa/project.example.json",
    "bin",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "prepack": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "typecheck": "tsc --noEmit && tsc -p virtocommerce --noEmit && tsc -p docs/examples --noEmit",
    "check": "biome check --write .",
    "check:ci": "biome ci --error-on-warnings .",
    "test:unit": "playwright test --project=unit",
    "docs:check": "node scripts/check-docs.ts",
    "docs:sync": "biome format --write docs/examples && node scripts/check-docs.ts --write",
    "docs:api": "node tools/typedoc/node_modules/typedoc/bin/typedoc",
    "changeset": "changeset",
    "release:version": "changeset version && biome format --write package.json",
    "release:publish": "changeset publish",
    "codegen:vc": "npm run build && npm run codegen:vc:graphql && npm run codegen:vc:rest",
    "codegen:vc:graphql": "graphql-codegen --config virtocommerce/codegen.ts",
    "codegen:vc:rest": "node virtocommerce/scripts/generate-rest-types.ts",
    "facts:check": "node virtocommerce/scripts/check-role-permissions.ts",
    "seed:vc": "playwright test -c virtocommerce --project=seed",
    "pretest:vc": "node -e \"require('node:fs').rmSync('virtocommerce/reports/allure-results', { recursive: true, force: true })\"",
    "test:vc": "playwright test -c virtocommerce --grep-invert @destructive",
    "test:vc:isolated": "playwright test -c virtocommerce --project=isolated",
    "test:vc:unit": "playwright test -c virtocommerce/playwright.unit.config.ts",
    "report:vc": "cd virtocommerce && allure generate reports/allure-results --clean",
    "report:vc:open": "cd virtocommerce && allure open reports/allure-report"
  },
  "simple-git-hooks": {
    "pre-commit": "npx biome check --staged --no-errors-on-unmatched"
  },
  "peerDependencies": {
    "@babel/parser": "^7.29.9",
    "@biomejs/biome": "^2.6.8",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "@playwright/test": "^1.65.1",
    "allure-playwright": "^3.14.0",
    "graphql": "^16.0.0 || ^17.0.0",
    "zod": "^4.0.7"
  },
  "peerDependenciesMeta": {
    "@babel/parser": {
      "optional": true
    },
    "@biomejs/biome": {
      "optional": true
    },
    "@graphql-codegen/cli": {
      "optional": true
    },
    "@graphql-codegen/client-preset": {
      "optional": true
    },
    "allure-playwright": {
      "optional": true
    },
    "graphql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "^2.6.8",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/client-preset": "7.0.0",
    "@graphql-codegen/schema-ast": "7.0.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "allure": "3.33.0",
    "allure-playwright": "3.14.0",
    "graphql": "16.15.0",
    "simple-git-hooks": "2.14.0",
    "swagger-typescript-api": "13.14.0",
    "tsc-alias": "^1.9.10",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  },
  "bin": {
    "vc-qa-agents": "bin/install-qa-agents.mjs"
  }
}
