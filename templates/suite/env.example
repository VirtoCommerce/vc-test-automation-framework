# The platform origin, such as https://backend.example.com (no path)
BACKEND_BASE_URL=
# The frontend origin, such as https://frontend.example.com (no path)
FRONTEND_BASE_URL=
# The login of the platform administrator, such as admin
ADMIN_USERNAME=
# The password of the platform administrator.
ADMIN_PASSWORD=
# The identifier of the store that the frontend serves, such as B2B-store
STORE_ID=
# The attribute that getByTestId reads in the frontend; left empty it is data-test-id
FRONTEND_TEST_ID_ATTRIBUTE=
VERIFY_SSL=true

# Customer accounts are added to .qa/project.json once they are seeded; set the password each one's passwordFor
# names, such as:
# CUSTOMER_PASSWORD=
# OTHER_CUSTOMER_PASSWORD=
